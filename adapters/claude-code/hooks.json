{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "openmicro-hook claude-hook --state thinking" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "openmicro-hook claude-hook --state working" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "openmicro-hook claude-hook --state awaiting_approval" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "openmicro-hook claude-hook --state idle" } ] }
    ]
  }
}
